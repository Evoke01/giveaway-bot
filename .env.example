# ── Telegram credentials ────────────────────────────────────────────────────
# Obtain from https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here
# For server/headless deployments, set SESSION_STRING instead of PHONE.
# Generate with: python -c "from telethon.sync import TelegramClient; from telethon.sessions import StringSession; c=TelegramClient(StringSession(), API_ID, API_HASH); c.start(); print(c.session.save())"
SESSION_STRING=
# Only needed when NOT using SESSION_STRING:
PHONE=+12025550123
SESSION_NAME=giveaway_bot

# ── Behaviour tuning ─────────────────────────────────────────────────────────
MAX_JOINS_PER_HOUR=15
JOIN_DELAY_MIN=1.0
JOIN_DELAY_MAX=5.0
CLICK_DELAY_MIN=2.0
CLICK_DELAY_MAX=6.0
WIN_CHECK_GRACE_MINUTES=60

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=giveaways.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
